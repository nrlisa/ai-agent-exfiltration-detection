{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPoCBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fyp-persistence-test"
    },
    {
      "Sid": "ReadPoCObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::fyp-persistence-test/*"
    }
  ]
}
